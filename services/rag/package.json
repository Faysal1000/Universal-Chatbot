{
  "name": "rag",
  "private": true,
  "version": "0.1.0",
  "description": "Core RAG backend: document ingestion orchestration, hybrid retrieval, grounded chat and the admin API.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node --env-file-if-exists=.env --enable-source-maps dist/main.api.js",
    "start:worker": "node --env-file-if-exists=.env --enable-source-maps dist/main.worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --enable-source-maps dist/database/run-migrations.js",
    "contracts:generate": "node scripts/generate-contract-types.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "admin:hash-password": "node dist/cli/hash-admin-password.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/lib-storage": "3.1158.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "6.5.1",
    "busboy": "1.6.0",
    "cookie": "2.0.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "js-tiktoken": "1.0.21",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "type": "module"
}
