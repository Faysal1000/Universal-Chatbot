# ── Build-time / dev settings (Vite exposes only VITE_CHAT_* to the browser) ──────────────────────────
# Base URL of the rag service's public API. Empty = same origin (the dev proxy below, or a reverse proxy).
VITE_CHAT_API_BASE_URL=
# Fallback branding shown before GET /v1/public/config answers.
VITE_CHAT_BOT_NAME=Universal Assistant
VITE_CHAT_BRAND_ACCENT=#6d5dfc
VITE_CHAT_BRAND_LOGO_URL=
# Message batching: messages are held for a random quiet window in [min, max] ms, reset by new input or typing.
VITE_CHAT_BATCH_QUIET_MIN_MS=1000
VITE_CHAT_BATCH_QUIET_MAX_MS=2000
# Hard cap: a batch is sent at the latest this long after its first message, even if the user keeps typing.
VITE_CHAT_BATCH_MAX_WAIT_MS=10000
# Default UI language: en | bn
VITE_CHAT_DEFAULT_LANGUAGE=en

# ── Local tooling (not shipped to the browser) ──────────────────────────────────────────────────────────
CHAT_DEV_SERVER_PORT=5190
# `npm run dev` proxies /v1 here: the rag api of the root docker-compose.yml.
CHAT_DEV_RAG_API_URL=http://localhost:8080
# End-to-end tests seed documents and chatbot settings through rag's admin API. Export it from
# services/rag/.env (RAG_ADMIN_API_KEY) in your shell; never commit it.
# CHAT_E2E_RAG_ADMIN_API_KEY=

# ── Docker runtime (nginx writes these into /runtime-config.js at container start; overrides VITE_CHAT_*) ──
# CHAT_RUNTIME_API_BASE_URL=https://rag.example.com
# CHAT_RUNTIME_BOT_NAME=Acme Assistant
# CHAT_RUNTIME_BRAND_ACCENT=#0f766e
# CHAT_RUNTIME_BRAND_LOGO_URL=
# CHAT_RUNTIME_CSP_CONNECT_SRC=https://rag.example.com
