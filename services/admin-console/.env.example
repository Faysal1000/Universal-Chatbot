# Admin console BFF for local development (`npm run dev`) against the root stack's localhost ports.
# In Docker, the root docker-compose.yml sets all of these from platform.env instead.
ADMIN_CONSOLE_PORT=8086
ADMIN_CONSOLE_LOG_LEVEL=info
# Browsers accept Secure cookies on http://localhost, so this can stay true.
ADMIN_CONSOLE_COOKIE_SECURE=true

ADMIN_CONSOLE_ADMIN_USERNAME=admin
# From `npm run hash-password` (never the plain password).
ADMIN_CONSOLE_ADMIN_PASSWORD_HASH=

ADMIN_CONSOLE_LLM_GATEWAY_URL=http://localhost:4000
ADMIN_CONSOLE_LLM_GATEWAY_ADMIN_API_KEY=same_value_as_LLM_GATEWAY_ADMIN_API_KEY_in_platform_env
ADMIN_CONSOLE_RAG_URL=http://localhost:8080
ADMIN_CONSOLE_RAG_WORKER_URL=http://localhost:8081
ADMIN_CONSOLE_RAG_ADMIN_API_KEY=same_value_as_RAG_ADMIN_API_KEY_in_platform_env
ADMIN_CONSOLE_LOCAL_LLM_URL=http://localhost:8095
ADMIN_CONSOLE_LOCAL_LLM_ADMIN_API_KEY=same_value_as_LOCAL_LLM_ADMIN_API_KEY_in_platform_env
ADMIN_CONSOLE_EMBEDDING_SERVER_URL=http://localhost:8000
ADMIN_CONSOLE_DOCUMENT_PARSER_URL=http://localhost:8090
