# ==============================================================================
#  LLM Gateway — environment variables
#  Copy to ".env" next to docker-compose.yml. Every variable is namespaced with
#  LLM_GATEWAY_ so it cannot collide with other services in the monorepo.
#
#  Generate all secrets at once (from services/llm-gateway):
#      python -m app.cli generate-secrets
#  Hash the admin password (prompts twice; prints the hash line):
#      python -m app.cli hash-password
#  or without a local Python environment (after `docker compose build`):
#      docker run --rm -it llm-gateway-backend:local python -m app.cli hash-password
#
#  Provider API keys are NOT configured here: add providers in the admin console
#  (services/admin-console) or through the admin API,
#  where keys are encrypted with LLM_GATEWAY_ENCRYPTION_KEY before storage.
# ==============================================================================

# ----- Secrets (use a secret manager in real deployments) -----

# Required. Callers (the RAG backend) send it as "Authorization: Bearer <key>" or
# "X-API-Key: <key>". At least 32 characters.
LLM_GATEWAY_API_KEY=change_this_to_a_secure_random_string_of_32_plus_chars

# Required. Only services/local-llm uses it, to register its deployments through
# /v1/local-models. Must differ from LLM_GATEWAY_API_KEY. At least 32 characters.
LLM_GATEWAY_REGISTRATION_API_KEY=change_this_to_a_different_random_string_of_32_plus_chars

# Optional. Lets the admin console's backend call /admin/api with "Authorization: Bearer <key>"
# (no session, no CSRF header). Blank disables it. Must differ from both keys above. At least
# 32 characters. The root docker-compose.yml sets it from platform.env (LLM_GATEWAY_ADMIN_API_KEY),
# the same value the admin console gets.
LLM_GATEWAY_ADMIN_API_KEY=

# Required. Fernet key that encrypts provider API keys and header values at rest.
# Losing it makes stored provider keys unreadable (re-enter them in the admin console).
LLM_GATEWAY_ENCRYPTION_KEY=

# Required. Signs admin session cookies. At least 32 characters.
LLM_GATEWAY_ADMIN_SESSION_SECRET=change_this_to_another_random_string_of_32_plus_chars

# Required. The single admin account for interactive /admin/api sessions (the admin console
# uses LLM_GATEWAY_ADMIN_API_KEY instead).
LLM_GATEWAY_ADMIN_USERNAME=admin
# scrypt hash from `python -m app.cli hash-password` (never the plain password).
LLM_GATEWAY_ADMIN_PASSWORD_HASH=

# ----- Database -----
# docker compose only: password of the bundled Postgres user "llm_gateway" (URL-safe).
LLM_GATEWAY_DATABASE_PASSWORD=change_this_gateway_db_password
# Running outside compose, or against any other Postgres (Neon: append ?ssl=require).
LLM_GATEWAY_DATABASE_URL=postgresql+asyncpg://llm_gateway:change_this_gateway_db_password@localhost:5433/llm_gateway
LLM_GATEWAY_DATABASE_POOL_SIZE=10
LLM_GATEWAY_DATABASE_MAX_OVERFLOW=10

# ----- HTTP server -----

LLM_GATEWAY_HOST=0.0.0.0
LLM_GATEWAY_PORT=4000
# development | staging | production (tags log lines)
LLM_GATEWAY_ENVIRONMENT=development
# Serve /docs and /openapi.json. Keep false in production.
LLM_GATEWAY_ENABLE_API_DOCS=true
# Hard cap on request body size in bytes (16 MiB; chat requests may carry base64 images).
LLM_GATEWAY_MAX_REQUEST_BODY_BYTES=16777216
# Seconds in-flight requests (including open streams) get to finish on SIGTERM.
LLM_GATEWAY_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# ----- Admin API session -----

# Session lifetime (default 12 hours).
LLM_GATEWAY_ADMIN_SESSION_TTL_SECONDS=43200
# Secure cookies need HTTPS. Set false only for plain-HTTP local development.
LLM_GATEWAY_ADMIN_COOKIE_SECURE=false
LLM_GATEWAY_ADMIN_LOGIN_MAX_FAILURES_PER_MINUTE=5

# ----- Logging -----

# DEBUG | INFO | WARNING | ERROR | CRITICAL (DEBUG also enables access logs)
LLM_GATEWAY_LOG_LEVEL=INFO
# text (human-readable) | json (for log aggregation)
LLM_GATEWAY_LOG_FORMAT=json

# ----- Upstream reliability -----

# Attempts per model before falling back (primary -> route fallback or default model).
LLM_GATEWAY_MAX_ATTEMPTS_PER_MODEL=3
# Exponential backoff with jitter between attempts; Retry-After is honoured up to the max.
LLM_GATEWAY_RETRY_BASE_DELAY_SECONDS=0.5
LLM_GATEWAY_RETRY_MAX_DELAY_SECONDS=8
LLM_GATEWAY_UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
# How long a request waits for a free per-provider concurrency slot before failing over.
LLM_GATEWAY_CONCURRENCY_SLOT_WAIT_TIMEOUT_SECONDS=10
LLM_GATEWAY_UPSTREAM_MAX_CONNECTIONS=512
# Routing/provider configuration cache; admin changes apply immediately on this replica.
LLM_GATEWAY_ROUTING_CACHE_TTL_SECONDS=5

# ----- Request metrics storage -----

# Monthly partitions older than this are dropped automatically.
LLM_GATEWAY_METRICS_RETENTION_DAYS=180
LLM_GATEWAY_METRICS_WRITE_BATCH_SIZE=500
LLM_GATEWAY_METRICS_FLUSH_INTERVAL_SECONDS=1.0
LLM_GATEWAY_METRICS_WRITE_QUEUE_CAPACITY=50000

# ----- docker compose host ports -----

LLM_GATEWAY_BACKEND_HOST_PORT=4000
LLM_GATEWAY_POSTGRES_HOST_PORT=5433
