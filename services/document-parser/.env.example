# ==============================================================================
#  document-parser — environment variables (placeholders only)
#  Copy to ".env" for local development. Every variable is namespaced with
#  DOCUMENT_PARSER_ so it cannot collide with other services in the monorepo.
#  In the root docker-compose, connection settings and secrets come from platform.env.
# ==============================================================================

# ----- Queues (Redis + BullMQ) -----
# The Redis rag uses for its BullMQ queues.
DOCUMENT_PARSER_REDIS_URL=redis://localhost:6379/0
# Must match RAG_REDIS_KEY_PREFIX: the parse.* queues belong to rag.
DOCUMENT_PARSER_QUEUE_PREFIX=rag
# Jobs processed in parallel per queue. parse.pages is CPU bound.
DOCUMENT_PARSER_PARSE_INSPECT_CONCURRENCY=2
DOCUMENT_PARSER_PARSE_PAGES_CONCURRENCY=1
# Job lock (renewed every half period while the job runs) and stalled-job check interval.
DOCUMENT_PARSER_LOCK_DURATION_SECONDS=600
DOCUMENT_PARSER_STALLED_INTERVAL_SECONDS=30
# Time active jobs get to finish on SIGTERM; unfinished jobs are retried as stalled.
DOCUMENT_PARSER_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=60

# ----- Object storage (S3 / MinIO) -----
DOCUMENT_PARSER_S3_ENDPOINT=http://localhost:9000
DOCUMENT_PARSER_S3_REGION=us-east-1
# Jobs referencing any other bucket fail permanently (bucket_not_allowed).
DOCUMENT_PARSER_S3_BUCKET=rag
DOCUMENT_PARSER_S3_ACCESS_KEY_ID=platform-admin
DOCUMENT_PARSER_S3_SECRET_ACCESS_KEY=change_this_storage_root_password
DOCUMENT_PARSER_S3_FORCE_PATH_STYLE=true
DOCUMENT_PARSER_S3_TIMEOUT_SECONDS=30
# Upper bounds for downloaded sources and decoded image uploads.
DOCUMENT_PARSER_MAXIMUM_SOURCE_BYTES=268435456
DOCUMENT_PARSER_MAXIMUM_IMAGE_PIXELS=150000000

# ----- LLM gateway (document_parse vision task) -----
DOCUMENT_PARSER_LLM_GATEWAY_URL=http://localhost:4000
DOCUMENT_PARSER_LLM_GATEWAY_API_KEY=change_this_gateway_api_key
DOCUMENT_PARSER_GATEWAY_MAX_ATTEMPTS=4
DOCUMENT_PARSER_GATEWAY_INITIAL_BACKOFF_SECONDS=2
DOCUMENT_PARSER_GATEWAY_MAX_BACKOFF_SECONDS=30
DOCUMENT_PARSER_DOCUMENT_PARSE_MAX_TOKENS=8744

# ----- Parsing -----
DOCUMENT_PARSER_TESSERACT_LANGUAGES=eng+ben
# OCR renders at least at this DPI (the job's renderDpi is used for the vision model).
DOCUMENT_PARSER_OCR_RENDER_DPI=300
# Time Tesseract always gets, even when the page deadline is nearly spent.
DOCUMENT_PARSER_MINIMUM_OCR_SECONDS=60
# Page renders are scaled down to stay under this many pixels.
DOCUMENT_PARSER_MAXIMUM_RENDER_PIXELS=40000000

# ----- Health server -----
DOCUMENT_PARSER_HOST=0.0.0.0
DOCUMENT_PARSER_PORT=8090
DOCUMENT_PARSER_READINESS_TIMEOUT_SECONDS=3

# ----- Logging -----
DOCUMENT_PARSER_LOG_LEVEL=INFO
# text | json
DOCUMENT_PARSER_LOG_FORMAT=text
