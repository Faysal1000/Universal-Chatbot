{
  "name": "@faysal1000/universal-chatbot",
  "version": "0.3.0",
  "description": "Embeddable website chat for the Universal Chatbot RAG platform: the <universal-chat-bot> Web Component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faysal1000/Universal-Chatbot.git",
    "directory": "services/chat-widget"
  },
  "homepage": "https://github.com/Faysal1000/Universal-Chatbot/tree/main/services/chat-widget#readme",
  "keywords": [
    "chatbot",
    "rag",
    "web-component",
    "chat-widget"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/universal-chat-bot.js",
  "module": "./dist/universal-chat-bot.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/universal-chat-bot.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts"
    },
    "./embed.js": "./dist/embed.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/universal-chat-bot.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:bundle && npm run build:embed",
    "build:bundle": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "size": "node scripts/checkBundleSize.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --tsconfig tsconfig.node.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run size",
    "demo": "vite --config demo/vite.config.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-text": "^4.0.3",
    "i18next": "^26.5.11",
    "jsdom": "^29.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.63.0",
    "mdast-util-find-and-replace": "^3.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
