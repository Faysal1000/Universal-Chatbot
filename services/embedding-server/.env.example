# ==============================================================================
#  Embedding Server — environment variables
#  Copy to ".env" for local development. Every variable is namespaced with
#  EMBEDDING_SERVER_ so it cannot collide with other services in the monorepo.
# ==============================================================================

# ----- Secrets (use a secret manager in real deployments) -----

# Required. Clients send it in the X-API-Key header. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMBEDDING_SERVER_API_KEY=change_this_to_a_secure_random_string_of_32_plus_chars

# Optional. Only needed for gated or private Hugging Face models.
EMBEDDING_SERVER_HUGGINGFACE_TOKEN=

# ----- HTTP server -----

EMBEDDING_SERVER_HOST=0.0.0.0
EMBEDDING_SERVER_PORT=8000
# Serve /docs and /openapi.json. Keep false in production.
EMBEDDING_SERVER_ENABLE_API_DOCS=true
# Hard cap on request body size in bytes (16 MiB).
EMBEDDING_SERVER_MAX_REQUEST_BODY_BYTES=16777216
# Seconds to finish in-flight requests on SIGTERM; the worker gets the same budget
# to drain its queue. Any orchestrator stop timeout must exceed 2x this.
EMBEDDING_SERVER_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# ----- Logging -----

# DEBUG | INFO | WARNING | ERROR | CRITICAL (DEBUG also enables access logs)
EMBEDDING_SERVER_LOG_LEVEL=INFO
# text (human-readable) | json (for log aggregation)
EMBEDDING_SERVER_LOG_FORMAT=text

# ----- Model & hardware -----

EMBEDDING_SERVER_MODEL_NAME=google/embeddinggemma-2
# Pin to a commit SHA in production so vectors stay reproducible. Blank = latest.
EMBEDDING_SERVER_MODEL_REVISION=
# auto (prefer CUDA) | cpu | cuda (fail fast if no GPU)
EMBEDDING_SERVER_DEVICE=auto
# PyTorch intra-op threads on CPU. Set to the container CPU limit. Blank = PyTorch default.
EMBEDDING_SERVER_CPU_INFERENCE_THREADS=
# Matryoshka output size: 256 | 512 | 768. Changing it needs a new rag index version.
EMBEDDING_SERVER_EMBEDDING_DIMENSION=768

# ----- Dynamic batching & admission control -----

# Maximum items sent to the model in one forward pass (1-256).
EMBEDDING_SERVER_INFERENCE_BATCH_SIZE=16
# How long the oldest queued item may wait for the batch to fill (0-1000 ms).
EMBEDDING_SERVER_BATCH_COLLECTION_WINDOW_MILLISECONDS=10
# Items admitted at once (queued + in inference). Beyond this, requests get 503 + Retry-After.
EMBEDDING_SERVER_MAX_PENDING_ITEMS=256
# End-to-end deadline per request, including validation and queueing (seconds).
EMBEDDING_SERVER_REQUEST_TIMEOUT_SECONDS=120

# ----- Input safety limits -----

# Items per /v1/embed/batch request. Must be <= MAX_PENDING_ITEMS.
EMBEDDING_SERVER_MAX_BATCH_ITEMS=64
EMBEDDING_SERVER_MAX_TEXT_CHARACTERS=24000
EMBEDDING_SERVER_MAX_TITLE_CHARACTERS=512
# Text longer than this is rejected (never silently truncated).
EMBEDDING_SERVER_MAX_TEXT_TOKENS=7800
# Decoded image size in bytes (5 MiB). Must be < MAX_REQUEST_BODY_BYTES.
EMBEDDING_SERVER_MAX_IMAGE_BYTES=5242880
# Decompression-bomb guard: total pixels before resizing.
EMBEDDING_SERVER_MAX_IMAGE_PIXELS=25000000
# Images are downscaled so neither side exceeds this many pixels (256-8192).
EMBEDDING_SERVER_MAX_IMAGE_SIDE_PIXELS=2048
# Images decoded in parallel (bounded thread pool).
EMBEDDING_SERVER_IMAGE_DECODE_CONCURRENCY=4
