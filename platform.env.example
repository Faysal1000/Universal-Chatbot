# ==============================================================================
#  Universal Chatbot: secrets for the root docker-compose.yml.
#  Copy to "platform.env" (gitignored) and replace every change_this value:
#    cp platform.env.example platform.env
#  Generate secrets with: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
#
#  Optional per-service settings go in services/<service>/.env (see each .env.example), e.g. the
#  Hugging Face token EmbeddingGemma needs: EMBEDDING_SERVER_HUGGINGFACE_TOKEN in services/embedding-server/.env.
# ==============================================================================

# ----- PostgreSQL (Neon) -----
# One database for both services; it also holds rag's search index (pgvector, available on Neon).
# Use Neon's direct host (no "-pooler"): rag holds session locks.
RAG_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full
LLM_GATEWAY_DATABASE_URL=postgresql+asyncpg://user:password@ep-example.region.aws.neon.tech/neondb?ssl=require

# ----- Object storage (any S3-compatible bucket, e.g. Neon's) -----
S3_ENDPOINT=https://example.aws.neon.tech
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=change_this_access_key_id
S3_SECRET_ACCESS_KEY=change_this_secret_access_key

# ----- Model servers -----
# rag calls the embedding server with this key.
EMBEDDING_SERVER_API_KEY=change_this_embedding_server_api_key_32_plus_chars
LOCAL_LLM_INFERENCE_API_KEY=change_this_local_llm_inference_api_key_32_plus_chars
# local-llm registers its models with llm-gateway using this key.
LOCAL_MODEL_REGISTRATION_API_KEY=change_this_local_model_registration_key_32_plus_chars

# ----- llm-gateway -----
# rag and the document parser call the gateway with this key.
LLM_GATEWAY_API_KEY=change_this_llm_gateway_api_key_32_plus_characters
# Fernet key for stored provider API keys: cd services/llm-gateway && python -m app.cli generate-secrets
LLM_GATEWAY_ENCRYPTION_KEY=change_this_fernet_key
LLM_GATEWAY_ADMIN_SESSION_SECRET=change_this_gateway_session_secret_32_plus_chars
# Hash from: cd services/llm-gateway && python -m app.cli hash-password
LLM_GATEWAY_ADMIN_PASSWORD_HASH=change_this_gateway_admin_password_hash

# ----- rag -----
# Keys the hashes that identify public chat clients; changing it forgets every client.
RAG_CLIENT_HASH_SECRET=change_this_client_hash_secret_to_32_plus_characters

# ----- Admin console -----
# The one admin sign-in. Hash from: cd services/admin-console && npm run hash-password
ADMIN_CONSOLE_ADMIN_USERNAME=admin
ADMIN_CONSOLE_ADMIN_PASSWORD_HASH=change_this_admin_console_admin_password_hash
# Keep true (HTTPS, or http://localhost); false only for plain HTTP on another host.
ADMIN_CONSOLE_COOKIE_SECURE=true
# Service admin keys, shared by each service and the console. At least 32 characters each.
RAG_ADMIN_API_KEY=change_this_rag_admin_api_key_32_plus_characters
LOCAL_LLM_ADMIN_API_KEY=change_this_local_llm_admin_api_key_32_plus_chars
LLM_GATEWAY_ADMIN_API_KEY=change_this_llm_gateway_admin_api_key_32_plus_chars
