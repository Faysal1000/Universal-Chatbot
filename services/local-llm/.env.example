# ==============================================================================
#  local-llm — environment variables
#  Copy to ".env" for local development. Every variable is namespaced with
#  LOCAL_LLM_ so it cannot collide with other services in the monorepo.
#  Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# ----- Secrets (use a secret manager in real deployments) -----

# Required. llm-gateway sends it on /v1 (Authorization: Bearer or X-API-Key). At least 32 characters.
# It is sent to llm-gateway on every registration, so it never has to be copied there by hand.
LOCAL_LLM_INFERENCE_API_KEY=change_this_to_a_secure_random_string_of_32_plus_chars
# Required and different from the inference key. The admin console sends it on /admin/v1.
LOCAL_LLM_ADMIN_API_KEY=change_this_to_another_secure_random_string_32_plus
# Optional. Only needed for gated or private Hugging Face models.
LOCAL_LLM_HUGGINGFACE_TOKEN=
# Hugging Face organisations whose repositories may run their own Python code when loaded
# (Nemotron Parse needs this). Comma-separated. GGUF models never run repository code.
LOCAL_LLM_TRUSTED_CODE_ORGANIZATIONS=nvidia

# ----- HTTP server -----

LOCAL_LLM_HOST=0.0.0.0
LOCAL_LLM_PORT=8000
# Serve /docs and /openapi.json. Keep false in production.
LOCAL_LLM_ENABLE_API_DOCS=true
# Hard cap on request body size in bytes (16 MiB, the same as llm-gateway).
LOCAL_LLM_MAX_REQUEST_BODY_BYTES=16777216
LOCAL_LLM_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# ----- Logging -----

# DEBUG | INFO | WARNING | ERROR | CRITICAL (DEBUG also shows llama-server output)
LOCAL_LLM_LOG_LEVEL=INFO
# text (human-readable) | json (for log aggregation)
LOCAL_LLM_LOG_FORMAT=text

# ----- State -----

# deployments.json lives here; mount a volume so admin deployments survive restarts.
LOCAL_LLM_STATE_DIRECTORY=/var/lib/local-llm

# ----- System deployment: Nemotron Parse (always loaded, cannot be removed) -----
# These seed the first boot. Later upgrades go through PATCH /admin/v1/deployments/nemotron-parse.

LOCAL_LLM_SYSTEM_DEPLOYMENT_NAME=nemotron-parse
LOCAL_LLM_SYSTEM_MODEL_ID=nvidia/Nemotron-3.5-Parse
# Pin to a commit SHA in production so a model push cannot silently change parsing. Blank = main.
LOCAL_LLM_SYSTEM_MODEL_REVISION=
# auto (GPU if it fits, else CPU) | gpu | cpu
LOCAL_LLM_SYSTEM_DEVICE=auto
# auto = float32 on CPU (fastest there) and bfloat16 on GPU | bfloat16 | float16 | float32
LOCAL_LLM_SYSTEM_DTYPE=auto
LOCAL_LLM_SYSTEM_CONTEXT_WINDOW_TOKENS=16384
LOCAL_LLM_SYSTEM_MAX_OUTPUT_TOKENS=8744
# Gateway tasks routed to the parser when they have no route yet (an admin's route always wins).
LOCAL_LLM_SYSTEM_DEFAULT_FOR_TASKS=document_parse,table_extraction,equation_ocr,chart_description

# ----- Document parser page size -----
# Pages are downscaled (never upscaled) to this many pixels before parsing; boxes stay normalised.
# 1.0 MP = A4 at ~100 DPI: body text stays legible and CPU parsing is ~4x faster than at 150 DPI.
LOCAL_LLM_PARSER_CPU_MAX_IMAGE_PIXELS=1000000
LOCAL_LLM_PARSER_GPU_MAX_IMAGE_PIXELS=3407872

# ----- Memory admission -----

# Kept free for the OS, Python and buffers; never handed to models.
LOCAL_LLM_MEMORY_RESERVE_BYTES=1073741824
LOCAL_LLM_GPU_MEMORY_RESERVE_BYTES=536870912
# Override detected RAM (cgroup limit or physical RAM). Blank = detect.
LOCAL_LLM_MEMORY_CAPACITY_BYTES=
# Context window for deployments that do not set one (keeps KV memory small on CPU).
LOCAL_LLM_DEFAULT_CONTEXT_WINDOW_TOKENS=8192

# ----- Inference -----

# PyTorch and llama.cpp threads on CPU. Blank = physical cores.
LOCAL_LLM_CPU_INFERENCE_THREADS=
# Requests generating at once per deployment, and how many may wait before 503 + Retry-After.
LOCAL_LLM_CONCURRENT_REQUESTS_PER_DEPLOYMENT=1
LOCAL_LLM_MAX_QUEUED_REQUESTS_PER_DEPLOYMENT=8
# End-to-end deadline per request in seconds.
LOCAL_LLM_REQUEST_TIMEOUT_SECONDS=600
# Per-image limits: decoded bytes and pixels (decompression-bomb guard).
LOCAL_LLM_MAX_IMAGE_BYTES=10485760
LOCAL_LLM_MAX_IMAGE_PIXELS=40000000
# Window for the tokens/s and pages/min figures in the admin API.
LOCAL_LLM_THROUGHPUT_WINDOW_SECONDS=900

# ----- llama.cpp (GGUF deployments) -----

LOCAL_LLM_LLAMA_SERVER_BINARY=/opt/llama.cpp/llama-server
LOCAL_LLM_LLAMA_SERVER_STARTUP_TIMEOUT_SECONDS=300

# ----- llm-gateway registration (blank LOCAL_LLM_GATEWAY_BASE_URL = do not register) -----

# The defaults are the service names in the root docker-compose.yml. services/local-llm/docker-compose.yml
# runs on its own and overrides both URLs with host.docker.internal addresses.
LOCAL_LLM_GATEWAY_BASE_URL=http://llm-gateway:4000
# Must equal LLM_GATEWAY_REGISTRATION_API_KEY in llm-gateway.
LOCAL_LLM_GATEWAY_REGISTRATION_API_KEY=
# How the gateway reaches this service (/v1 is appended). Every registration also sends
# LOCAL_LLM_INFERENCE_API_KEY, which the gateway stores encrypted and uses to call /v1.
LOCAL_LLM_PUBLIC_BASE_URL=http://local-llm:8000
LOCAL_LLM_GATEWAY_RETRY_MAX_BACKOFF_SECONDS=60
