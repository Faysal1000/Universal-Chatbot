# ==============================================================================
#  rag: one environment file for both ways of running the service.
#  Copy to ".env" next to docker-compose.yml, then set every secret.
#
#  Part 1 (compose secrets and host ports) is interpolated into docker-compose.yml.
#  Part 2 (RAG_*) is the application configuration. docker compose passes it to the
#  containers and overrides the connection URLs with container hostnames. Running
#  natively (npm run start:api / start:worker) reads it as is:
#      node --env-file=.env dist/main.api.js
#  Use the same passwords in Part 1 and in the Part 2 connection URLs.
#  Generate secrets with: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# ==============================================================================

# ----- Part 1: compose secrets and host ports -----

# Password of the `rag` Postgres user (owner of the `rag` database).
POSTGRES_PASSWORD=change_this_database_password
# MinIO credentials; rag uses them too.
OBJECT_STORAGE_ROOT_USER=platform-admin
OBJECT_STORAGE_ROOT_PASSWORD=change_this_storage_root_password

# Host ports (change if they clash with something already running).
RAG_API_HOST_PORT=8080
RAG_WORKER_HOST_PORT=8081
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
OBJECT_STORAGE_HOST_PORT=9000
OBJECT_STORAGE_CONSOLE_HOST_PORT=9001

# ----- Part 2: application configuration (RAG_*) -----
# Every variable is namespaced with RAG_ so it cannot collide with other services.

# ----- Secrets & connections (use a secret manager in real deployments) -----

# Required. Any PostgreSQL database with the pgvector extension available (local container, Neon, RDS, ...).
RAG_DATABASE_URL=postgresql://rag:change_this_database_password@localhost:5432/rag
# Required. Redis with maxmemory-policy noeviction (BullMQ needs it).
RAG_REDIS_URL=redis://localhost:6379/0
# Required. S3-compatible object storage (MinIO locally). Leave the endpoint blank for AWS S3.
RAG_S3_ENDPOINT=http://localhost:9000
RAG_S3_REGION=us-east-1
RAG_S3_BUCKET=rag
RAG_S3_ACCESS_KEY_ID=platform-admin
RAG_S3_SECRET_ACCESS_KEY=change_this_storage_root_password
# MinIO needs path-style URLs (http://host/bucket/key); AWS S3 works either way.
RAG_S3_FORCE_PATH_STYLE=true

# ----- HTTP server -----

RAG_HOST=0.0.0.0
# The api listens here; run the worker with a different port when both run natively.
RAG_PORT=8080
# development | staging | production (tags log lines)
RAG_ENVIRONMENT=development
# Serve Swagger UI on /docs and the spec on /openapi.json. Keep false in production.
RAG_ENABLE_API_DOCS=true
# Maximum JSON request body (1 MiB). File uploads use a separate, streaming limit.
RAG_JSON_BODY_LIMIT_BYTES=1048576
# Seconds to drain in-flight work on SIGTERM. Orchestrator stop timeouts must exceed it.
RAG_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# ----- Logging -----

# trace | debug | info | warn | error | fatal
RAG_LOG_LEVEL=info
# text (human-readable) | json (for log aggregation)
RAG_LOG_FORMAT=text

# ----- PostgreSQL -----

RAG_DATABASE_POOL_SIZE=10
# Any single SQL statement is cancelled after this long.
RAG_DATABASE_STATEMENT_TIMEOUT_MILLISECONDS=30000

# ----- Redis -----

# Namespace for every key and BullMQ queue of this service (lowercase slug).
RAG_REDIS_KEY_PREFIX=rag

# ----- Readiness -----

# Each dependency check in /health/ready must answer within this time.
RAG_DEPENDENCY_CHECK_TIMEOUT_MILLISECONDS=2000

# ----- embedding-server (EmbeddingGemma 2) -----

# Required. Base URL; the root compose overrides it with http://embedding-server:8000.
RAG_EMBEDDING_SERVER_URL=http://localhost:8000
# Required. Must equal EMBEDDING_SERVER_API_KEY of the embedding-server.
RAG_EMBEDDING_SERVER_API_KEY=change_this_embedding_server_api_key
RAG_EMBEDDING_SERVER_TIMEOUT_MILLISECONDS=120000
# Items per /v1/embed/batch request (the server accepts at most 64).
RAG_EMBEDDING_BATCH_SIZE=32

# ----- llm-gateway (OpenAI Chat Completions; `model` is the task name) -----

# Required. The root compose overrides it with http://llm-gateway:4000.
RAG_LLM_GATEWAY_URL=http://localhost:4000
# Required. Must equal LLM_GATEWAY_API_KEY of the gateway.
RAG_LLM_GATEWAY_API_KEY=change_this_llm_gateway_api_key
# Whole-request limit for non-streamed calls (query_rewrite, conversation_summary).
RAG_LLM_GATEWAY_TIMEOUT_MILLISECONDS=120000
# A streamed answer is abandoned when no data arrives for this long.
RAG_LLM_GATEWAY_STREAM_IDLE_TIMEOUT_MILLISECONDS=60000
# How long GET /v1/tasks/{task} limits (context window, max output) are cached.
RAG_LLM_TASK_LIMITS_CACHE_SECONDS=60
# query_rewrite is skipped (the visitor's own words are searched) when it takes longer.
RAG_QUERY_REWRITE_TIMEOUT_MILLISECONDS=20000

# ----- Admin API (used by the admin console) -----

# First admin, created or updated at start-up (e.g. `admin`). Both or neither.
RAG_ADMIN_BOOTSTRAP_USERNAME=
# From `npm run build && echo -n 'password' | npm run -s admin:hash-password`.
# Keep the single quotes: the hash contains `$`, which docker compose would interpolate.
RAG_ADMIN_BOOTSTRAP_PASSWORD_HASH=
# Optional bearer key for the admin console backend (32+ characters).
RAG_ADMIN_API_KEY=
RAG_ADMIN_SESSION_TTL_SECONDS=43200
# Set to false only for plain-HTTP local development.
RAG_ADMIN_COOKIE_SECURE=true

# ----- Public chat API -----

# Required. HMAC key for client IPs and device fingerprints (32+ characters).
RAG_CLIENT_HASH_SECRET=change_this_client_hash_secret_to_32_plus_characters
# Comma-separated origins allowed to call /v1/public (the chat frontend).
RAG_PUBLIC_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Reverse proxies in front of the service whose X-Forwarded-For entry is trusted (1 on HF Spaces).
RAG_TRUSTED_PROXY_HOPS=0
RAG_VISITOR_SESSION_TTL_SECONDS=2592000
# Cloudflare Turnstile. Both or neither; without them visitor sessions need no challenge.
RAG_TURNSTILE_SITE_KEY=
RAG_TURNSTILE_SECRET_KEY=
RAG_RATE_LIMIT_TURNS_PER_MINUTE_PER_SESSION=6
RAG_RATE_LIMIT_TURNS_PER_MINUTE_PER_FINGERPRINT=10
RAG_RATE_LIMIT_TURNS_PER_MINUTE_PER_IP=30
RAG_RATE_LIMIT_SESSIONS_PER_HOUR_PER_IP=20
RAG_RATE_LIMIT_REQUESTS_PER_MINUTE_PER_IP=300
# Tokens (input + output) all visitors together may spend per UTC day.
RAG_DAILY_TOKEN_BUDGET=2000000
# Images attached to chat messages.
RAG_MAX_ATTACHMENT_BYTES=5242880
# Multiplier on o200k token counts, covering tokenizers that split text more finely.
RAG_TOKEN_ESTIMATE_SAFETY_FACTOR=1.2

# ----- Data retention (maintenance job in the worker) -----

RAG_MAINTENANCE_INTERVAL_MINUTES=60
# Visitor sessions, with their conversations and images, are deleted this long after expiring.
RAG_VISITOR_DATA_RETENTION_DAYS=90
# Retrieval traces (per-turn search debugging data) are deleted after this many days.
RAG_RETRIEVAL_TRACE_RETENTION_DAYS=30

# ----- Ingestion -----

RAG_MAX_UPLOAD_BYTES=52428800
RAG_MAX_PAGES_PER_DOCUMENT=200
# Pages per parse.pages job; batches of one document are parsed in parallel.
RAG_PARSE_PAGES_PER_JOB=8
# Nemotron Parse takes ~13 s/page natively and ~44 s/page in Docker on CPU.
RAG_PARSE_PAGE_TIMEOUT_SECONDS=900
RAG_PARSE_RENDER_DPI=144
RAG_MAX_VISION_MODEL_CALLS_PER_DOCUMENT=500
# Parallel jobs per queue in the worker process.
RAG_WORKER_CONCURRENCY=2
