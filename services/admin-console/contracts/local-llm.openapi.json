{
  "openapi": "3.1.0",
  "info": {
    "title": "local-llm",
    "description": "Self-hosted open-weight models (Nemotron Parse and admin deployments) behind llm-gateway.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "The process is up and its event loop answers.",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "Ready only when the system deployment (Nemotron Parse) serves requests and no shutdown is under way.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readiness Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": [
          "inference"
        ],
        "summary": "List Models",
        "description": "Deployments that are loaded and ready to serve.",
        "operationId": "list_models_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            }
          }
        },
        "security": [
          {
            "InferenceBearer": []
          },
          {
            "InferenceHeader": []
          }
        ]
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": [
          "inference"
        ],
        "summary": "Create Chat Completion",
        "description": "Generate a completion; ``stream: true`` returns Server-Sent Events ending with ``[DONE]``.",
        "operationId": "create_chat_completion_v1_chat_completions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InferenceBearer": []
          },
          {
            "InferenceHeader": []
          }
        ]
      }
    },
    "/admin/v1/system": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Describe System",
        "description": "CPU, RAM and GPUs, plus how much memory admission control can still hand out.",
        "operationId": "describe_system_admin_v1_system_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemView"
                }
              }
            }
          }
        },
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ]
      }
    },
    "/admin/v1/deployments": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List Deployments",
        "description": "Every deployment with status, device, memory and throughput.",
        "operationId": "list_deployments_admin_v1_deployments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentList"
                }
              }
            }
          }
        },
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ]
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create Deployment",
        "description": "Reserve memory and start downloading and loading; 409 if it cannot fit, 422 if it cannot run.",
        "operationId": "create_deployment_admin_v1_deployments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ]
      }
    },
    "/admin/v1/deployments/{deployment_name}": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Get Deployment",
        "description": "One deployment.",
        "operationId": "get_deployment_admin_v1_deployments__deployment_name__get",
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ],
        "parameters": [
          {
            "name": "deployment_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deployment Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Update Deployment",
        "description": "Change settings, or upgrade to a new model or revision (also for the system deployment).",
        "operationId": "update_deployment_admin_v1_deployments__deployment_name__patch",
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ],
        "parameters": [
          {
            "name": "deployment_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deployment Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Delete Deployment",
        "description": "Unload and remove (403 for the system deployment).",
        "operationId": "delete_deployment_admin_v1_deployments__deployment_name__delete",
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ],
        "parameters": [
          {
            "name": "deployment_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deployment Name"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/deployments/{deployment_name}/load": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Load Deployment",
        "description": "Load an unloaded or failed deployment.",
        "operationId": "load_deployment_admin_v1_deployments__deployment_name__load_post",
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ],
        "parameters": [
          {
            "name": "deployment_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deployment Name"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/deployments/{deployment_name}/unload": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Unload Deployment",
        "description": "Free the deployment's memory (403 for the system deployment).",
        "operationId": "unload_deployment_admin_v1_deployments__deployment_name__unload_post",
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ],
        "parameters": [
          {
            "name": "deployment_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deployment Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/deployments/{deployment_name}/restart": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Restart Deployment",
        "description": "Unload and load again.",
        "operationId": "restart_deployment_admin_v1_deployments__deployment_name__restart_post",
        "security": [
          {
            "AdminBearer": []
          },
          {
            "AdminHeader": []
          }
        ],
        "parameters": [
          {
            "name": "deployment_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deployment Name"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Model"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 512,
            "minItems": 1,
            "title": "Messages"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "stream_options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StreamOptions"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens"
          },
          "max_completion_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Completion Tokens"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "top_p": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top P"
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          },
          "repetition_penalty": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Repetition Penalty"
          },
          "stop": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "chat_template_kwargs": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat Template Kwargs"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatCompletionRequest",
        "description": "``POST /v1/chat/completions`` body. ``model`` is the deployment name."
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "developer",
              "user",
              "assistant",
              "tool"
            ],
            "title": "Role"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TextContentPart"
                    },
                    {
                      "$ref": "#/components/schemas/ImageContentPart"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                      "image_url": "#/components/schemas/ImageContentPart",
                      "text": "#/components/schemas/TextContentPart"
                    }
                  }
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "role"
        ],
        "title": "ChatMessage",
        "description": "One conversation turn."
      },
      "ConfiguredSettingsView": {
        "properties": {
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision",
            "description": "null = main"
          },
          "device": {
            "type": "string",
            "enum": [
              "auto",
              "gpu",
              "cpu"
            ],
            "title": "Device"
          },
          "dtype": {
            "type": "string",
            "enum": [
              "auto",
              "bfloat16",
              "float16",
              "float32"
            ],
            "title": "Dtype"
          },
          "context_window_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Window Tokens",
            "description": "null = the model's native window, capped by the default"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Output Tokens",
            "description": "null = the service default"
          },
          "reasoning_control": {
            "type": "string",
            "enum": [
              "auto",
              "reasoning_effort",
              "enable_thinking"
            ],
            "title": "Reasoning Control"
          }
        },
        "type": "object",
        "required": [
          "revision",
          "device",
          "dtype",
          "context_window_tokens",
          "max_output_tokens",
          "reasoning_control"
        ],
        "title": "ConfiguredSettingsView",
        "description": "Exactly what the admin configured; the top-level fields show what the service resolved and runs."
      },
      "DeploymentCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "title": "Name",
            "examples": [
              "qwen3.5-0.8b"
            ]
          },
          "model_id": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*(:[A-Za-z0-9_.-]+)?$",
            "title": "Model Id",
            "examples": [
              "unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M"
            ]
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision",
            "description": "Commit SHA, branch or tag; blank = main"
          },
          "device": {
            "type": "string",
            "enum": [
              "auto",
              "gpu",
              "cpu"
            ],
            "title": "Device",
            "default": "auto"
          },
          "dtype": {
            "type": "string",
            "enum": [
              "auto",
              "bfloat16",
              "float16",
              "float32"
            ],
            "title": "Dtype",
            "description": "Transformers models only; GGUF files fix their own",
            "default": "auto"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "context_window_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1048576.0,
                "minimum": 256.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Window Tokens"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1048576.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Output Tokens"
          },
          "default_for_tasks": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,62}$"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Default For Tasks"
          },
          "reasoning_control": {
            "type": "string",
            "enum": [
              "auto",
              "reasoning_effort",
              "enable_thinking"
            ],
            "title": "Reasoning Control",
            "description": "How llm-gateway switches reasoning for this deployment: `auto` registers `enable_thinking` when the model's chat template has Qwen's thinking switch and otherwise leaves the gateway's setting alone",
            "default": "auto"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "model_id"
        ],
        "title": "DeploymentCreateRequest",
        "description": "Deploy a Hugging Face model (``org/repo``, or ``org/repo:QUANT`` for GGUF) under a name."
      },
      "DeploymentList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DeploymentView"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "DeploymentList",
        "description": "Every deployment, system deployment first."
      },
      "DeploymentStatus": {
        "type": "string",
        "enum": [
          "unloaded",
          "downloading",
          "loading",
          "ready",
          "unloading",
          "failed"
        ],
        "title": "DeploymentStatus",
        "description": "Lifecycle of a deployment; only ``READY`` deployments serve requests."
      },
      "DeploymentUpdateRequest": {
        "properties": {
          "model_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*(:[A-Za-z0-9_.-]+)?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "device": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "gpu",
                  "cpu"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          },
          "dtype": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "bfloat16",
                  "float16",
                  "float32"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Dtype"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "context_window_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1048576.0,
                "minimum": 256.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Window Tokens"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1048576.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Output Tokens"
          },
          "default_for_tasks": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,62}$"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Default For Tasks"
          },
          "reasoning_control": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "reasoning_effort",
                  "enable_thinking"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Control",
            "description": "How llm-gateway switches reasoning for this deployment: `auto` registers `enable_thinking` when the model's chat template has Qwen's thinking switch and otherwise leaves the gateway's setting alone"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DeploymentUpdateRequest",
        "description": "Change a deployment; a new ``model_id`` or ``revision`` swaps the model without downtime when memory allows."
      },
