{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist/server",
    "rootDir": "server",
    "sourceMap": true
  },
  "include": ["server"],
  "exclude": ["server/**/*.test.ts"]
}
